hal_client_domain(system_app, hal_mlipay)
hal_client_domain(system_app, vendor_hal_displayfeature)

# Thermal Profiles
allow system_app sysfs_therm:dir search;
allow system_app sysfs_therm:file { write };
allow system_app sysfs_therm:file { getattr open read };

# Charge Speed Limit
allow system_app sysfs_power_supply:dir r_dir_perms;
allow system_app sysfs_power_supply:file { rw_file_perms setattr };
allow system_app sysfs_power_supply:lnk_file r_file_perms;
allow system_app sysfs_batteryinfo:dir search;

# Core Control
allow system_app vendor_sysfs_corecontrol:file rw_file_perms;

# High touch polling rate (re-applied by XiaomiParts after screen on)
allow system_app vendor_sysfs_touch:dir search;
allow system_app vendor_sysfs_touch:file { getattr w_file_perms };

# Hanita Mods Game Space: read-only game metrics (FPS/GPU from GED, skin temperature)
r_dir_file(system_app, sysfs_ged)
r_dir_file(system_app, sysfs_therm)
