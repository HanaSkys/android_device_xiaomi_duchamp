allow init sysfs_power_supply:file { setattr };
r_dir_file(init, sysfs_batteryinfo)

# Charge Speed Limit
allow init sysfs_power_supply:dir { r_dir_perms setattr relabelfrom relabelto };
allow init sysfs_power_supply:file { rw_file_perms setattr relabelfrom relabelto };
allow init sysfs_power_supply:lnk_file { r_file_perms relabelfrom relabelto };

allow init sysfs_batteryinfo:dir { r_dir_perms setattr relabelfrom relabelto };
allow init sysfs_batteryinfo:file { rw_file_perms setattr relabelfrom relabelto };
r_dir_file(init, sysfs_batteryinfo)
