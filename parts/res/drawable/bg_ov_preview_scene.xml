<!-- A stand-in "game" behind the opacity preview -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#FFC98D6B"
                android:endColor="#FF3B5A3A"
                android:startColor="#FF2B4C7E"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
