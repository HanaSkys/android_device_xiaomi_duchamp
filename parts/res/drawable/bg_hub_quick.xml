<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <ripple android:color="@color/hub_ripple">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/hub_accent" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <ripple android:color="@color/hub_ripple">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/hub_card" />
                    <stroke android:width="1dp" android:color="@color/hub_card_stroke" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
