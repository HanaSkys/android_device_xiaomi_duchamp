<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hub_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hub_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/hub_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/hub_back"
            style="@style/HubBack"
            android:layout_marginBottom="12dp" />

        <!-- Hero with live stats -->
        <FrameLayout
            android:id="@+id/hub_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hub_hero">

            <com.xiaomi.settings.hub.SakuraPetalsView
                android:id="@+id/hub_petals"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:text="@string/hub_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/hub_hero_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="-0.02"
                    android:text="@string/hub_title"
                    android:textColor="@color/hub_hero_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/HubHeroStat"
                        android:layout_marginStart="0dp">
                        <TextView android:id="@+id/stat_battery" style="@style/HubHeroStatValue" />
                        <TextView android:id="@+id/stat_battery_label" style="@style/HubHeroStatLabel" />
                    </LinearLayout>

                    <LinearLayout style="@style/HubHeroStat">
                        <TextView android:id="@+id/stat_health" style="@style/HubHeroStatValue" />
                        <TextView style="@style/HubHeroStatLabel" android:text="@string/hub_stat_health" />
                    </LinearLayout>

                    <LinearLayout style="@style/HubHeroStat">
                        <TextView android:id="@+id/stat_temp" style="@style/HubHeroStatValue" />
                        <TextView style="@style/HubHeroStatLabel" android:text="@string/hub_stat_temp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Quick toggles -->
        <TextView
            style="@style/HubSection"
            android:layout_marginTop="24dp"
            android:text="@string/hub_section_quick" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/quick_bypass" style="@style/HubQuick"
                android:contentDescription="@string/hub_bypass_title">
                <ImageView style="@style/HubQuickIcon" android:src="@drawable/ic_bh_bypass" />
                <TextView style="@style/HubQuickLabel" android:text="@string/hub_quick_bypass" />
            </LinearLayout>

            <LinearLayout android:id="@+id/quick_touch" style="@style/HubQuick"
                android:contentDescription="@string/hub_touch_title">
                <ImageView style="@style/HubQuickIcon" android:src="@drawable/ic_hub_touch" />
                <TextView style="@style/HubQuickLabel" android:text="@string/hub_quick_touch" />
            </LinearLayout>

            <LinearLayout android:id="@+id/quick_bbr" style="@style/HubQuick"
                android:contentDescription="@string/hub_quick_bbr_description">
                <ImageView style="@style/HubQuickIcon" android:src="@drawable/ic_hub_network" />
                <TextView style="@style/HubQuickLabel" android:text="@string/hub_quick_bbr" />
            </LinearLayout>

            <LinearLayout android:id="@+id/quick_smart" style="@style/HubQuick"
                android:contentDescription="@string/hub_smart_title">
                <ImageView style="@style/HubQuickIcon" android:src="@drawable/ic_bh_smart_charging" />
                <TextView style="@style/HubQuickLabel" android:text="@string/hub_quick_smart" />
            </LinearLayout>
        </LinearLayout>

        <!-- Categories -->
        <TextView
            style="@style/HubSection"
            android:layout_marginTop="24dp"
            android:text="@string/hub_section_categories" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cat_battery"
                style="@style/HubCategory"
                android:layout_marginEnd="6dp">
                <ImageView style="@style/HubCategoryIcon" android:src="@drawable/ic_hub_battery" />
                <Space style="@style/HubCategorySpace" />
                <TextView style="@style/HubCategoryTitle" android:text="@string/hub_section_battery" />
                <TextView android:id="@+id/cat_battery_status" style="@style/HubCategoryStatus" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cat_display"
                style="@style/HubCategory"
                android:layout_marginStart="6dp">
                <ImageView style="@style/HubCategoryIcon" android:src="@drawable/ic_hub_display" />
                <Space style="@style/HubCategorySpace" />
                <TextView style="@style/HubCategoryTitle" android:text="@string/hub_section_touch" />
                <TextView android:id="@+id/cat_display_status" style="@style/HubCategoryStatus" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cat_performance"
                style="@style/HubCategory"
                android:layout_marginEnd="6dp">
                <ImageView style="@style/HubCategoryIcon" android:src="@drawable/ic_hub_speed" />
                <Space style="@style/HubCategorySpace" />
                <TextView style="@style/HubCategoryTitle" android:text="@string/hub_section_performance" />
                <TextView android:id="@+id/cat_performance_status" style="@style/HubCategoryStatus" />
            </LinearLayout>

            <!-- Game Space: coming soon -->
            <LinearLayout
                android:id="@+id/cat_game"
                style="@style/HubCategory"
                android:layout_marginStart="6dp"
                android:alpha="0.7"
                android:clickable="false"
                android:focusable="false">
                <ImageView style="@style/HubCategoryIcon" android:src="@drawable/ic_hub_game" />
                <Space style="@style/HubCategorySpace" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HubCategoryTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/hub_cat_game" />

                    <TextView style="@style/HubBadge" android:text="@string/hub_badge_soon" />
                </LinearLayout>

                <TextView style="@style/HubCategoryStatus" android:text="@string/hub_cat_game_summary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/hub_footer"
            android:textColor="@color/hub_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
